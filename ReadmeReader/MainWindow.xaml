<Window x:Class="ReadmeReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="markit"
        Icon="Assets/markit.ico"
        Height="780"
        MinHeight="560"
        Width="1180"
        MinWidth="860"
        Background="#EEF6FF"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        MouseMove="Window_MouseMove"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#C6D9EE" />
        <SolidColorBrush x:Key="ControlTextBrush" Color="#0B1F3A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B708A" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF7FF" />
        <SolidColorBrush x:Key="ControlSelectionBrush" Color="#D9EEFF" />
        <SolidColorBrush x:Key="ControlSelectionTextBrush" Color="#06172C" />
        <SolidColorBrush x:Key="ControlDisabledBrush" Color="#E7EEF6" />

        <Style x:Key="ToolbarFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1"
                                   Stroke="#0EA5E9"
                                   StrokeThickness="2"
                                   RadiusX="8"
                                   RadiusY="8" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C6D9EE" />
            <Setter Property="Foreground" Value="#0B1F3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlSelectionBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="ContentSite" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0EA5E9" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.72" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlSelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ControlSelectionTextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,0,28,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      RecognizesAccessKey="True" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="{TemplateBinding Padding}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             SelectionBrush="{DynamicResource ControlSelectionBrush}"
                                             SelectionTextBrush="{DynamicResource ControlSelectionTextBrush}"
                                             Visibility="Hidden" />
                                    <Path Width="8"
                                          Height="5"
                                          Margin="0,0,11,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlDisabledBrush}" />
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconOnlyButton" BasedOn="{StaticResource ToolbarButton}" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="ToolbarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SwatchButton" TargetType="RadioButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer"
                                Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#94A3B8"
                                BorderThickness="1">
                            <Border x:Name="Inner"
                                    Width="10"
                                    Height="10"
                                    CornerRadius="5"
                                    Background="#111827"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#0EA5E9" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Inner" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#0EA5E9" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Cambiar tema" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToolbarFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="58"
                                Height="30"
                                CornerRadius="15"
                                Background="#D6E5F4"
                                BorderBrush="#A9BED6"
                                BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Knob"
                                         Width="24"
                                         Height="24"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="#FFFFFF" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3A3A37" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#78716C" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="#F3F0E8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A8A29E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0EA5E9" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootPanel"
          KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Toolbar"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#C6D9EE"
                BorderThickness="0,0,0,1"
                Padding="14,12,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Orientation="Horizontal"
                           KeyboardNavigation.TabNavigation="Continue"
                           KeyboardNavigation.DirectionalNavigation="Contained">
                    <Border Width="118"
                            Height="36"
                            Margin="0,0,14,8"
                            VerticalAlignment="Center">
                        <Image x:Name="BrandLogo"
                               Source="Assets/markit-logo-horizontal-light.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               AutomationProperties.Name="markit" />
                    </Border>

                    <Border Width="1" Height="28" Margin="0,4,10,12" Background="#CBD5E1" />

                    <Button x:Name="OpenButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Abrir Markdown"
                            AutomationProperties.HelpText="Abre un archivo Markdown o de texto"
                            ToolTip="Abrir Markdown"
                            Click="OpenButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8E5;" />
                            <TextBlock Text="Abrir" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="RecentFilesBox"
                              Style="{StaticResource ToolbarComboBox}"
                              Width="190"
                              Height="36"
                              Margin="0,0,8,8"
                              IsEditable="False"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="Archivos recientes"
                              AutomationProperties.HelpText="Lista los ultimos documentos abiertos"
                              ToolTip="Archivos recientes"
                              DropDownOpened="ComboBox_DropDownOpened"
                              SelectionChanged="RecentFilesBox_SelectionChanged" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Guardar documento"
                            AutomationProperties.HelpText="Guarda los cambios en el archivo actual"
                            ToolTip="Guardar"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE74E;" />
                            <TextBlock Text="Guardar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveAsButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Guardar documento como"
                            AutomationProperties.HelpText="Guarda una copia del Markdown en otra ubicacion"
                            ToolTip="Guardar como"
                            Click="SaveAsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE792;" />
                            <TextBlock Text="Guardar como" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrintButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Imprimir documento"
                            AutomationProperties.HelpText="Abre el dialogo de impresion"
                            ToolTip="Imprimir"
                            Click="PrintButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE749;" />
                            <TextBlock Text="Imprimir" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportPdfButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Exportar documento a PDF"
                            AutomationProperties.HelpText="Genera una copia PDF del Markdown actual"
                            ToolTip="Exportar PDF"
                            Click="ExportPdfButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8A5;" />
                            <TextBlock Text="Exportar PDF" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="28" Margin="2,4,10,12" Background="#CBD5E1" />

                    <RadioButton x:Name="YellowHighlightButton"
                                 Style="{StaticResource SwatchButton}"
                                 Background="#FFF3A3"
                                 Tag="#FFF3A3"
                                 AutomationProperties.Name="Color de resaltador amarillo"
                                 ToolTip="Resaltador amarillo"
                                 IsChecked="True"
                                 Checked="HighlightColor_Checked" />
                    <RadioButton Style="{StaticResource SwatchButton}"
                                 Background="#CFF7D3"
                                 Tag="#CFF7D3"
                                 AutomationProperties.Name="Color de resaltador verde"
                                 ToolTip="Resaltador verde"
                                 Checked="HighlightColor_Checked" />
                    <RadioButton Style="{StaticResource SwatchButton}"
                                 Background="#FFD6E7"
                                 Tag="#FFD6E7"
                                 AutomationProperties.Name="Color de resaltador rosa"
                                 ToolTip="Resaltador rosa"
                                 Checked="HighlightColor_Checked" />
                    <RadioButton Style="{StaticResource SwatchButton}"
                                 Background="#CDEBFF"
                                 Tag="#CDEBFF"
                                 AutomationProperties.Name="Color de resaltador celeste"
                                 ToolTip="Resaltador celeste"
                                 Checked="HighlightColor_Checked" />
                    <RadioButton Style="{StaticResource SwatchButton}"
                                 Background="#E6D7FF"
                                 Tag="#E6D7FF"
                                 AutomationProperties.Name="Color de resaltador lila"
                                 ToolTip="Resaltador lila"
                                 Checked="HighlightColor_Checked" />
                    <Button x:Name="HighlightButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Activar resaltador"
                            AutomationProperties.HelpText="Resalta la seleccion o deja activo el resaltador hasta presionar Escape"
                            ToolTip="Resaltar seleccion"
                            Click="HighlightButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7E6;" />
                            <TextBlock Text="Resaltar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveHighlightButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Activar goma de resaltado"
                            AutomationProperties.HelpText="Quita resaltados guardados de la seleccion o deja activa la goma hasta presionar Escape"
                            ToolTip="Quitar resaltado"
                            Click="RemoveHighlightButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE75C;" />
                            <TextBlock Text="Quitar" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="28" Margin="2,4,10,12" Background="#CBD5E1" />

                    <ToggleButton x:Name="ThemeToggle"
                                  Style="{StaticResource ThemeSwitch}"
                                  AutomationProperties.Name="Cambiar tema claro u oscuro"
                                  AutomationProperties.HelpText="Alterna entre modo claro y modo oscuro"
                                  Checked="ThemeToggle_Changed"
                                  Unchecked="ThemeToggle_Changed" />
                    <Button x:Name="FullScreenButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Pantalla completa"
                            AutomationProperties.HelpText="Entra o sale del modo lectura en pantalla completa"
                            ToolTip="Pantalla completa"
                            Click="FullScreenButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE740;" />
                            <TextBlock Text="Pantalla completa" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="28" Margin="2,4,10,12" Background="#CBD5E1" />

                    <Button x:Name="ZoomOutButton"
                            Style="{StaticResource IconOnlyButton}"
                            Content="-"
                            AutomationProperties.Name="Alejar documento"
                            ToolTip="Alejar"
                            Click="ZoomOutButton_Click" />
                    <ComboBox x:Name="ZoomScaleBox"
                              Style="{StaticResource ToolbarComboBox}"
                              Width="86"
                              Height="36"
                              Margin="0,0,8,8"
                              IsEditable="False"
                              IsReadOnly="True"
                              AutomationProperties.Name="Escala de zoom"
                              AutomationProperties.HelpText="Selecciona una escala de lectura entre 50 y 300 por ciento"
                              VerticalContentAlignment="Center"
                              DropDownOpened="ComboBox_DropDownOpened"
                              SelectionChanged="ZoomScaleBox_SelectionChanged">
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="75%" Tag="75" />
                        <ComboBoxItem Content="90%" Tag="90" />
                        <ComboBoxItem Content="100%" Tag="100" IsSelected="True" />
                        <ComboBoxItem Content="125%" Tag="125" />
                        <ComboBoxItem Content="150%" Tag="150" />
                        <ComboBoxItem Content="175%" Tag="175" />
                        <ComboBoxItem Content="200%" Tag="200" />
                        <ComboBoxItem Content="250%" Tag="250" />
                        <ComboBoxItem Content="300%" Tag="300" />
                    </ComboBox>
                    <Button x:Name="ZoomInButton"
                            Style="{StaticResource IconOnlyButton}"
                            Content="+"
                            AutomationProperties.Name="Acercar documento"
                            ToolTip="Acercar"
                            Click="ZoomInButton_Click" />
                    <Button x:Name="ZoomResetButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="100%"
                            Width="58"
                            Padding="0"
                            AutomationProperties.Name="Restablecer zoom al 100 por ciento"
                            ToolTip="Restablecer zoom"
                            Click="ZoomResetButton_Click" />

                    <Border Width="1" Height="28" Margin="2,4,10,12" Background="#CBD5E1" />

                    <Button x:Name="SearchButton"
                            Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="Buscar en documento"
                            AutomationProperties.HelpText="Abre la busqueda del documento"
                            ToolTip="Buscar"
                            Click="SearchButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE721;" />
                            <TextBlock Text="Buscar" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Border x:Name="SearchPanel"
                        Grid.Row="1"
                        Margin="0,4,0,8"
                        Padding="10,8"
                        Background="#FFFFFF"
                        BorderBrush="#C6D9EE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SearchBox"
                                 Width="320"
                                 Height="36"
                                 Margin="0,0,8,0"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#C6D9EE"
                                 AutomationProperties.Name="Buscar texto"
                                 AutomationProperties.HelpText="Escribe texto y presiona Enter para buscar en el documento"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown" />
                        <Button x:Name="RunSearchButton"
                                Style="{StaticResource ToolbarButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Ejecutar busqueda"
                                ToolTip="Buscar"
                                Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE721;" />
                                <TextBlock Text="Buscar" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="SearchCountText"
                                   Width="68"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   AutomationProperties.Name="Cantidad de coincidencias"
                                   Foreground="#475569" />
                        <Button x:Name="PreviousMatchButton"
                                Style="{StaticResource IconOnlyButton}"
                                Content="‹"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Coincidencia anterior"
                                ToolTip="Coincidencia anterior"
                                Click="PreviousMatchButton_Click" />
                        <Button x:Name="NextMatchButton"
                                Style="{StaticResource IconOnlyButton}"
                                Content="›"
                                Margin="0,0,0,0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Coincidencia siguiente"
                                ToolTip="Coincidencia siguiente"
                                Click="NextMatchButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#475569"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border x:Name="DocumentFrame"
                Grid.Row="1"
                Margin="22"
                Background="#FFFFFF"
                BorderBrush="#C8DAEE"
                BorderThickness="1"
                CornerRadius="8">
            <FlowDocumentScrollViewer x:Name="Viewer"
                                      Padding="0"
                                      Background="#FFFFFF"
                                      IsSelectionEnabled="True"
                                      AutomationProperties.Name="Documento Markdown"
                                      KeyboardNavigation.TabNavigation="Continue"
                                      PreviewMouseLeftButtonUp="Viewer_PreviewMouseLeftButtonUp"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Zoom="100"
                                      MinZoom="50"
                                      MaxZoom="300"
                                      ZoomIncrement="10" />
        </Border>

        <Border x:Name="FloatingMarkupToolbar"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Padding="10,8,2,0"
                Background="#F8FAFC"
                BorderBrush="#C6D9EE"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                Panel.ZIndex="20"
                MouseEnter="FloatingMarkupToolbar_MouseEnter"
                MouseLeave="FloatingMarkupToolbar_MouseLeave">
            <WrapPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SwatchButton}"
                             Background="#FFF3A3"
                             Tag="#FFF3A3"
                             AutomationProperties.Name="Color de resaltador amarillo"
                             ToolTip="Resaltador amarillo"
                             Checked="HighlightColor_Checked" />
                <RadioButton Style="{StaticResource SwatchButton}"
                             Background="#CFF7D3"
                             Tag="#CFF7D3"
                             AutomationProperties.Name="Color de resaltador verde"
                             ToolTip="Resaltador verde"
                             Checked="HighlightColor_Checked" />
                <RadioButton Style="{StaticResource SwatchButton}"
                             Background="#FFD6E7"
                             Tag="#FFD6E7"
                             AutomationProperties.Name="Color de resaltador rosa"
                             ToolTip="Resaltador rosa"
                             Checked="HighlightColor_Checked" />
                <RadioButton Style="{StaticResource SwatchButton}"
                             Background="#CDEBFF"
                             Tag="#CDEBFF"
                             AutomationProperties.Name="Color de resaltador celeste"
                             ToolTip="Resaltador celeste"
                             Checked="HighlightColor_Checked" />
                <RadioButton Style="{StaticResource SwatchButton}"
                             Background="#E6D7FF"
                             Tag="#E6D7FF"
                             AutomationProperties.Name="Color de resaltador lila"
                             ToolTip="Resaltador lila"
                             Checked="HighlightColor_Checked" />
                <Button Style="{StaticResource ToolbarButton}"
                        AutomationProperties.Name="Activar resaltador"
                        ToolTip="Resaltar seleccion"
                        Click="HighlightButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7E6;" />
                        <TextBlock Text="Resaltar" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        AutomationProperties.Name="Activar goma de resaltado"
                        ToolTip="Quitar resaltado"
                        Click="RemoveHighlightButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE75C;" />
                        <TextBlock Text="Quitar" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
