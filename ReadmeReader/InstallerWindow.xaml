<Window x:Class="ReadmeReader.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar Markit"
        Icon="Assets/markit.ico"
        Width="660"
        Height="620"
        MinWidth="600"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Image Source="Assets/markit-logo-horizontal-light.png"
                   Width="146"
                   Height="44"
                   HorizontalAlignment="Left"
                   Stretch="Uniform"
                   AutomationProperties.Name="Markit" />
            <TextBlock Text="Instalador de Markit"
                       Margin="0,22,0,0"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827" />
            <TextBlock Text="Un lector simple y comodo para abrir archivos Markdown con formato, zoom, resaltado y modo lectura."
                       Margin="0,8,0,0"
                       MaxWidth="580"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="21"
                       Foreground="#475569" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,20"
                Padding="18"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel>
                    <TextBlock Text="Que se va a instalar"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Markit se copiara en tu usuario de Windows y quedara asociado a archivos .md, .markdown y .mdown."
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="#475569" />
                    <TextBlock Text="Carpeta de instalacion"
                               Margin="0,18,0,6"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathText"
                                 Height="34"
                                 Padding="9,6"
                                 Background="#F1F5F9"
                                 BorderBrush="#D7DEE8"
                                 Foreground="#334155"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="92"
                                Margin="8,0,0,0"
                                Content="Cambiar..."
                                Click="BrowseButton_Click" />
                    </Grid>

                    <CheckBox x:Name="AcceptCheckBox"
                              Margin="0,16,0,0"
                              Foreground="#1F2937"
                              Checked="AcceptCheckBox_Changed"
                              Unchecked="AcceptCheckBox_Changed">
                        <TextBlock Text="Acepto instalar Markit y asociar archivos Markdown con esta aplicacion."
                                   TextWrapping="Wrap" />
                    </CheckBox>

                    <ProgressBar x:Name="InstallProgressBar"
                                 Margin="0,16,0,0"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />
                    <TextBlock x:Name="ProgressText"
                               Margin="0,8,0,0"
                               Text="Listo para instalar."
                               TextWrapping="Wrap"
                               Foreground="#64748B" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="LaunchCheckBox"
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,12"
                      IsChecked="True"
                      Visibility="Collapsed"
                      Foreground="#1F2937">
                <TextBlock Text="Abrir Markit al finalizar"
                           TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       Text="Esperando confirmacion." />
            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Content="Cancelar"
                        Click="CancelButton_Click" />
                <Button x:Name="InstallButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Instalar"
                        IsEnabled="False"
                        Click="InstallButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
